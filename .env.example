# Токен бота от @BotFather. Никому не отправляйте и не коммитьте!
BOT_TOKEN=

# ID чата, куда приходят заявки (ваш личный ID или ID группы).
# Как узнать — см. README.
ADMIN_CHAT_ID=

# Путь к файлу базы SQLite (по умолчанию ./data/bot.db)
DB_PATH=./data/bot.db

# Режим webhook (необязательно). Если WEBHOOK_URL пустой — бот работает через polling.
# WEBHOOK_URL=https://bot.example.com/telegram
# WEBHOOK_SECRET=длинная-случайная-строка
# PORT=3000
